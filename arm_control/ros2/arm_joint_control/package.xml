<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_joint_control</name>
  <version>0.1.0</version>
  <description>ROS 2 side of the robotic arm joint control loop: a serial bridge to the ESP32 joint controller (setpoints out at 100 Hz, joint_states in) and a trapezoidal trajectory planner.</description>
  <maintainer email="rinkushah08@gmail.com">Rinku Shah</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>arm_common</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
