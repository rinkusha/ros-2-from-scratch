# esp32_joint_controller build defaults (idf.py picks these up on first configure)

# 1 ms tick so a 1-tick UART read timeout really is 1 ms.
CONFIG_FREERTOS_HZ=1000

# UART0 carries the binary protocol: keep the console and the bootloader quiet.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_COLORS=n

# Control task runs flat out on core 1; don't let the idle-task watchdog complain.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
